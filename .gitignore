# Python
__pycache__/
*.pyc
.venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Local LinkedIn session + usage tracking
# Wildcarded (not just the literal cookies.json) because
# ask_next_linkedin_account() in main.py lets you save a second/third
# rotated account's session under any filename (e.g. cookies2.json) -
# a literal-only pattern would silently let one of those get committed.
cookies.json
cookies*.json
*storage_state*.json
linkedin_usage.json

# Web GUI runtime data
webapp/data/*
!webapp/data/.gitkeep

# Kubernetes secrets
k8s/secret.yaml

# Local Excel / generated files
*.xlsx
*.xls
*.csv

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db